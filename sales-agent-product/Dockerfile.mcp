FROM python:3.12-slim
WORKDIR /app
COPY requirements-mcp.txt ./
RUN pip install --no-cache-dir -r requirements-mcp.txt && useradd --uid 10001 app
COPY sales_agent ./sales_agent
USER app
ENV PYTHONUNBUFFERED=1 DATA_DIR=/data APP_MODE=live RESEARCH_BACKEND=native SCHEDULE_ENABLED=false MAIL_SYNC_ENABLED=false MCP_PAID_ENABLED=false
EXPOSE 8081
CMD ["python", "-m", "sales_agent.mcp_server"]
