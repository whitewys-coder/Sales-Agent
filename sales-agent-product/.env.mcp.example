# Server-side secrets only. Never put these values in a Skill or chat prompt.
APP_MODE=live
RESEARCH_BACKEND=native
SCHEDULE_ENABLED=false
MAIL_SYNC_ENABLED=false
DATA_DIR=/data
APP_TOKEN=REPLACE_WITH_RANDOM_32_CHAR_OR_LONGER_VALUE
LEADCONTACT_TOKEN=REPLACE_SERVER_SIDE_ONLY
MCP_PAID_ENABLED=false
MCP_RESOURCE_URL=https://REPLACE_DOMAIN/mcp
MCP_ISSUER_URL=https://REPLACE_IDENTITY_PROVIDER
MCP_JWKS_URL=https://REPLACE_IDENTITY_PROVIDER/.well-known/jwks.json
MCP_ALLOWED_SUBJECT=REPLACE_OPERATOR_APPROVED_SUBJECT
